# Copy to .env.local.local for local dev, or pass via docker-compose env_file in production.
# Never commit the real values.

FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_TOKEN_PATH=/data/tokens/fitbit_token.json

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOKEN_CACHE_PATH=/data/tokens/.spotify_cache

# Was hardcoded in calendar_bp.py in the Flask app - move it here instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=/data/tokens/google_refresh_token.json

# Google Health API (Fitbit's successor - see bootstrap-tokens.mjs's
# bootstrapGoogleHealth). Reuses GOOGLE_CLIENT_ID/SECRET above, but needs its
# own refresh token in a separate file - the Health API rejects tokens that
# also carry other product scopes like Calendar's (confirmed via direct API
# test: 403 DISALLOWED_OAUTH_SCOPES), so it can't share GOOGLE_TOKEN_PATH.
GOOGLE_HEALTH_TOKEN_PATH=/data/tokens/google_health_token.json

# Shared file the sensor_poller process writes to and the sensors API route reads from.
SENSOR_DATA_PATH=/data/sensor/latest.json

# Weather location (was hardcoded lat/long in weather_bp.py)
WEATHER_LAT=49.2497
WEATHER_LON=-123.1193
