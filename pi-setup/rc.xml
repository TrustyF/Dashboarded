<?xml version="1.0"?>
<labwc_config>

  <!-- labwc-autostart rotates the DSI panel's *display* output 90deg CCW
       (`wlr-randr --output DSI-1 --transform 90`), but that doesn't rotate
       the touch digitizer's coordinates to match - taps land in the wrong
       place relative to what's visually shown, even though gesture-relative
       interactions like pinch-zoom still "work" since they only read
       relative motion between two touch points, not absolute position.

       Tried so far, testing each on the real hardware: 90deg CW, 90deg CCW,
       a computed 45deg CCW matrix, and removing calibration entirely
       (concluded net 0deg from measurements at the time). None of those
       held up - now trying 180deg instead of the original 90deg CW attempt. -->
  <libinput>
    <device category="touch">
      <calibrationMatrix>0 1 0 -1 0 1</calibrationMatrix>
    </device>
  </libinput>

</labwc_config>
