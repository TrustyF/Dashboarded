<?xml version="1.0"?>
<labwc_config>

  <!-- labwc-autostart rotates the DSI panel's *display* output 90deg CCW
       (`wlr-randr --output DSI-1 --transform 90`), but that doesn't rotate
       the touch digitizer's coordinates to match - taps land in the wrong
       place relative to what's visually shown (e.g. the on-screen bottom
       edge maps to touch input from a different physical edge of the
       panel), even though gesture-relative interactions like pinch-zoom
       still "work" since they only read relative motion between two touch
       points, not absolute position.

       First attempt used "0 1 0 -1 0 1" (90deg CCW, matching the display
       transform directly) - still wrong, so trying the other direction:
       "0 -1 1 1 0 0" (90deg CW) instead. If this is also wrong, the two
       most likely remaining candidates are 180deg ("-1 0 1 0 -1 1") or no
       rotation at all ("1 0 0 0 1 0", i.e. the touch digitizer may already
       self-report rotated coordinates and doesn't need this at all). -->
  <libinput>
    <device category="touch">
      <calibrationMatrix>0 -1 1 1 0 0</calibrationMatrix>
    </device>
  </libinput>

</labwc_config>
