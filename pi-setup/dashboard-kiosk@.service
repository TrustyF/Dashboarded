[Unit]
Description=Dashboard kiosk (cage + Chromium)
# Docker's own restart:unless-stopped handles the app container across
# reboots; this just needs Docker itself up before it bothers waiting.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
# PAMName+TTYPath gives this service a real logind session, which cage needs
# for DRM/input device access when it's not launched from an interactive
# login. Requires getty@tty1 to be disabled first (see install.sh) - only one
# thing can own a tty at a time.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

# Target hardware: DSI-1 (Raspberry Pi Touch Display 2, native 720x1280
# portrait) - confirmed via `wlr-randr` against the real device. Socket name
# (wayland-0) also confirmed live rather than assumed.
#
# WAYLAND_DISPLAY is deliberately NOT set here at the unit level - cage's
# own backend autodetection treats a pre-set WAYLAND_DISPLAY as "there's
# already a parent Wayland compositor, connect to it as a nested client"
# instead of using the DRM backend to talk to the GPU directly, which is
# what a kiosk actually needs. Learned this the hard way: setting it here
# made cage fail with "Unable to create the wlroots backend" - stayed
# "active (running)" per systemd, but never touched the actual display.
# It's only passed inline to the wlr-randr command below instead, once
# cage's own socket already exists.
Environment=XDG_RUNTIME_DIR=/run/user/%U

ExecStartPre=/usr/local/bin/wait-for-dashboard.sh
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-translate \
  --check-for-update-interval=31536000 \
  --ozone-platform=wayland \
  --window-size=1280,720 \
  http://localhost:3000
# Rotates the compositor's output (not the console/kernel level - a
# /boot/firmware/cmdline.txt `video=...,rotate=` attempt was a dead end,
# since that only affects the text console, not Wayland). --transform 90
# confirmed live against the real device (2026-08-19) to give the intended
# 90deg counter-clockwise rotation.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 20); do WAYLAND_DISPLAY=wayland-0 wlr-randr --output DSI-1 --transform 90 && break; sleep 0.5; done'

Restart=always
RestartSec=3

[Install]
# Raspberry Pi OS Lite boots to multi-user.target by default, not
# graphical.target (that's only reached on a Desktop image with a display
# manager) - cage doesn't need a display manager, it talks to DRM/KMS
# directly, so multi-user.target is the right thing to hook into here.
WantedBy=multi-user.target
