[Unit]
Description=Dashboard kiosk (cage + Chromium)
# Docker's own restart:unless-stopped handles the app container across
# reboots; this just needs Docker itself up before it bothers waiting.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
# PAMName+TTYPath gives this service a real logind session, which cage needs
# for DRM/input device access when it's not launched from an interactive
# login. Requires getty@tty1 to be disabled first (see install.sh) - only one
# thing can own a tty at a time.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

ExecStartPre=/usr/local/bin/wait-for-dashboard.sh
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-translate \
  --check-for-update-interval=31536000 \
  --ozone-platform=wayland \
  --window-size=800,480 \
  http://localhost:3000

Restart=always
RestartSec=3

[Install]
# Raspberry Pi OS Lite boots to multi-user.target by default, not
# graphical.target (that's only reached on a Desktop image with a display
# manager) - cage doesn't need a display manager, it talks to DRM/KMS
# directly, so multi-user.target is the right thing to hook into here.
WantedBy=multi-user.target
