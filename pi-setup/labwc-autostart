#!/bin/sh
# Installed as ~/.config/labwc/autostart - labwc runs this on startup. Runs
# as a real child of labwc, so it inherits WAYLAND_DISPLAY/XDG_RUNTIME_DIR
# correctly without needing to guess/hardcode them (unlike the systemd
# service approach this replaced, which fought cage's own backend
# autodetection and never got cage rendering at all - see project history).

# Rotate the DSI panel 90deg CCW (Wayland's own transform convention).
# Retries briefly since the output may not be registered the instant labwc
# starts.
for i in $(seq 1 20); do
  wlr-randr --output DSI-1 --transform 90 && break
  sleep 0.5
done

# The backlight's sysfs value persists across reboots as whatever it was
# last set to (e.g. from a previous toggle-brightness tap) - it doesn't
# reset to full on its own. app/api/settings/toggle-brightness/route.ts's
# in-memory currentBrightness assumes 100% at startup but never actually
# issues this command, so without it the app's displayed brightness can
# silently disagree with the real screen. Best-effort: brightnessctl's
# backlight driver is normally available this early, but this shouldn't
# block boot if it isn't.
brightnessctl set 100% || true

# Wait for the app container to actually be serving before Chromium tries
# to load it - Chromium doesn't retry a failed page load on its own.
/usr/local/bin/wait-for-dashboard.sh

# CDP lets deploy-to-pi.ps1 (via reload-dashboard.py) tell this exact running
# tab to reload after a deploy, instead of killing/relaunching chromium -
# there's no supervisor around this process (see the header comment above),
# so a kill here would leave the screen dead until someone power-cycles the
# Pi. Bound to loopback only: CDP has no auth, so anyone who could reach it
# would get full control of the browser (arbitrary JS, read local storage,
# etc.) - explicit --remote-debugging-address rather than relying on
# Chromium's default in case that default ever changes.
chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-translate \
  --check-for-update-interval=31536000 \
  --ozone-platform=wayland \
  --window-size=1280,720 \
  --remote-debugging-port=9222 \
  --remote-debugging-address=127.0.0.1 \
  http://localhost:3000 &

# Chromium doesn't hide the cursor from globals.sass's cursor:none CSS until
# it processes a real pointer event (see hide-cursor.py) - nudge it once so
# the cursor is already gone before anyone actually touches the screen.
# Backgrounded + retried since chromium/its CDP port/the page's own target
# all take a moment to be ready after the launch above.
(
  for i in $(seq 1 30); do
    python3 /usr/local/bin/hide-cursor.py && break
    sleep 1
  done
) &
